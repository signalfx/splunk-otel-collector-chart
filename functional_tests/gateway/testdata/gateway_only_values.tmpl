splunkObservability:
   realm:       CHANGEME
   accessToken: CHANGEME
   apiUrl: {{ .ApiURL }}
   ingestUrl: {{ .IngestURL }}

clusterName: test-cluster

agent:
  enabled: false

gateway:
  enabled: true
  replicaCount: 1
  resources:
    limits:
      cpu: 200m
      memory: 256Mi
  config:
    extensions:
      http_forwarder/o11y_ingest:
        egress:
          endpoint: {{ .IngestURL }}

clusterReceiver:
  enabled: false
