---
# db2.otlp.endpoint is deliberately unset: the subchart deriving it from this release is
# the contract under test.
splunkObservability:
  realm: test-realm
  accessToken: "dummy-token"
  ingestUrl: {{ .IngestURL }}
  apiUrl: {{ .ApiURL }}

clusterName: db2-functional-test

clusterReceiver:
  enabled: false

# Database Monitoring routing lives in the gateway config, so the gateway has to run and
# the receiver has to export to it.
gateway:
  enabled: true
  replicaCount: 1
  # The chart default is 4 CPU / 8Gi, which cannot be scheduled on a single-node kind
  # cluster alongside Db2. Matches the sizing the other gateway suites use.
  resources:
    limits:
      cpu: 200m
      memory: 256Mi

db2:
  enabled: true
  # Exercises the Database Monitoring wiring at runtime: a dedicated exporter, two
  # scope-keyed filters and the logs/dbmon pipeline. Chart unit tests cover what renders;
  # this covers the Collector accepting it and the metrics path surviving alongside it, as
  # a malformed OTTL condition or exporter block only fails once the Collector parses it.
  #
  # The sink is a SignalFx receiver and does not implement /v3/event, so the dbmon
  # exporter's own sends fail here. That is expected and not what this asserts.
  dbMonitoring:
    enabled: true
  otlp:
    collectorTarget: gateway
  receivers:
    - name: default
      hostname: db2.default.svc.cluster.local
      database: SAMPLE
      port: 50000
      collectionInterval: "10s"
      username: db2inst1
      password: db2inst1-pwd
      tls:
        insecure: true
      # Produces the log records the dbmon filters act on; without an event enabled the
      # pipeline would render but never see traffic.
      events:
        dbServerQuerySample:
          enabled: true
        # Top queries read the package cache, which is populated even on an otherwise idle
        # instance, so at least one Db2 log record is produced without synthetic load.
        dbServerTopQuery:
          enabled: true
