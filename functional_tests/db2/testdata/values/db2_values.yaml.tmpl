---
splunkObservability:
  realm: test-realm
  accessToken: "dummy-token"
  ingestUrl: {{ .IngestURL }}
  apiUrl: {{ .ApiURL }}
  dbMonitoringEnabled: true

clusterName: db2-functional-test

clusterReceiver:
  enabled: false

gateway:
  enabled: true
  replicaCount: 1
  # The chart default is 4 CPU / 8Gi, which cannot be scheduled on a single-node kind
  # cluster alongside Db2. Matches the sizing the other gateway suites use.
  resources:
    limits:
      cpu: 200m
      memory: 256Mi
  # The ingest URL is a SignalFx receiver and does not serve /v3/event, so this one
  # exporter is redirected at its own sink.
  config:
    exporters:
      otlp_http/dbmon:
        logs_endpoint: {{ .DbMonURL }}/v3/event

db2:
  enabled: true
  otlp:
    collectorTarget: gateway
  receivers:
    - name: default
      hostname: db2.default.svc.cluster.local
      database: SAMPLE
      port: 50000
      collectionInterval: "10s"
      username: db2inst1
      password: db2inst1-pwd
      tls:
        insecure: true
      # Produces the log records the dbmon filters act on; without an event enabled the
      # pipeline would render but never see traffic.
      events:
        dbServerQuerySample:
          enabled: true
        # Both are on so either can satisfy the delivery assertion. Neither is guaranteed on
        # its own: sampling reads currently-running activities, and top queries are computed
        # from deltas, so a first reading of the package cache only establishes a baseline.
        # The statement loop in testdata/db2/deployment.yaml is what makes an event certain.
        dbServerTopQuery:
          enabled: true
