---
# db2.otlp.endpoint is deliberately unset: the subchart deriving it from this release is
# the contract under test.
splunkObservability:
  realm: test-realm
  accessToken: "dummy-token"
  ingestUrl: {{ .IngestURL }}
  apiUrl: {{ .ApiURL }}

clusterName: db2-functional-test

# Only the agent is needed to receive the subchart's OTLP export.
clusterReceiver:
  enabled: false

db2:
  enabled: true
  receivers:
    - name: default
      hostname: db2.default.svc.cluster.local
      database: SAMPLE
      port: 50000
      collectionInterval: "10s"
      username: db2inst1
      password: db2inst1-pwd
      tls:
        insecure: true
