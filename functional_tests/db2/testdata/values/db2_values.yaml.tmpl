---
# db2.otlp.endpoint is deliberately unset: the subchart deriving it from this release is
# the contract under test.
splunkObservability:
  realm: test-realm
  accessToken: "dummy-token"
  ingestUrl: {{ .IngestURL }}
  apiUrl: {{ .ApiURL }}

clusterName: db2-functional-test

clusterReceiver:
  enabled: false

# Database Monitoring routing lives in the gateway config, so the gateway has to run and
# the receiver has to export to it.
gateway:
  enabled: true
  replicaCount: 1
  # The chart default is 4 CPU / 8Gi, which cannot be scheduled on a single-node kind
  # cluster alongside Db2. Matches the sizing the other gateway suites use.
  resources:
    limits:
      cpu: 200m
      memory: 256Mi
  # Database Monitoring events need a sink that serves /v3/event. The ingest URL above is a
  # SignalFx receiver, which does not, so only this exporter is redirected -- everything
  # else still goes through the chart's derived endpoints. The derived form of this value
  # is asserted in unittests/db2_subchart_test.yaml.
  config:
    exporters:
      otlp_http/dbmon:
        logs_endpoint: {{ .DbMonURL }}/v3/event

db2:
  enabled: true
  # dbMonitoring is deliberately not set: enabling the events below is what turns the
  # routing on, and leaving it out exercises that derivation. This covers the Database
  # Monitoring wiring at runtime -- a dedicated exporter, two scope-keyed filters and the
  # logs/dbmon pipeline -- where a malformed OTTL condition or exporter block only fails
  # once the Collector parses it, which rendering alone cannot catch.
  otlp:
    collectorTarget: gateway
  receivers:
    - name: default
      hostname: db2.default.svc.cluster.local
      database: SAMPLE
      port: 50000
      collectionInterval: "10s"
      username: db2inst1
      password: db2inst1-pwd
      tls:
        insecure: true
      # Produces the log records the dbmon filters act on; without an event enabled the
      # pipeline would render but never see traffic.
      events:
        dbServerQuerySample:
          enabled: true
        # Both are on so either can satisfy the delivery assertion. Neither is guaranteed on
        # its own: sampling reads currently-running activities, and top queries are computed
        # from deltas, so a first reading of the package cache only establishes a baseline.
        # The statement loop in testdata/db2/deployment.yaml is what makes an event certain.
        dbServerTopQuery:
          enabled: true
