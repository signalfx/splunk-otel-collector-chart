---
# Enables the splunk-otel-db2 subchart.
#
# db2.otlp.endpoint is deliberately left unset: the subchart deriving it from this release is
# the contract under test, so hard-coding it here would assert nothing.
splunkObservability:
  realm: test-realm
  accessToken: "dummy-token"

clusterName: db2-functional-test

# Only the agent is needed to receive the subchart's OTLP export and forward it on.
clusterReceiver:
  enabled: false

db2:
  enabled: true
  receivers:
    - name: default
      # No Db2 is deployed: this asserts the subchart's wiring, so the receiver only has to
      # start and resolve its exporter target. Scraping a real Db2 is covered in the
      # receiver's own suite, which already budgets for the image's long startup.
      hostname: db2.default.svc.cluster.local
      database: SAMPLE
      port: 50000
      collectionInterval: "10s"
      username: db2inst1
      password: db2inst1-pwd
      tls:
        insecure: true
